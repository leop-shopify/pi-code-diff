{
  "name": "pi-code-diff",
  "version": "0.3.6",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "type": "module",
  "description": "Interactive code diff editor for Pi with comments, AI-assisted review handoff, GitHub PR integration, and local or remote diff support.",
  "author": "Leonardo Pereira",
  "license": "MIT",
  "files": [
    "src/diff.ts",
    "src/git.ts",
    "src/index.ts",
    "src/locale-files.ts",
    "src/pi-render.ts",
    "src/path-policy.ts",
    "src/prompt.ts",
    "src/pr-summary.ts",
    "src/remote.ts",
    "src/review-grammar.ts",
    "src/review-session.ts",
    "src/review-submit.ts",
    "src/sanitize.ts",
    "src/search.ts",
    "src/seed-comments.ts",
    "src/shortcuts.ts",
    "src/state.ts",
    "src/syntax-highlight.ts",
    "src/theme-highlight.ts",
    "src/types.ts",
    "src/ui",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "diff-review",
    "code-diff",
    "code-review",
    "diff-editor",
    "annotation",
    "github-pr",
    "remote-diff",
    "ai-review",
    "terminal"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "benchmark": "vitest bench --run"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.78.0",
    "@earendil-works/pi-tui": "0.78.0",
    "@pierre/diffs": "1.2.7",
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "0.78.0"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  }
}
